# Prorun AI — environment configuration
# Copy to .env.local and fill in what you have. The app works fully offline
# with its built-in deterministic analysis engine and seeded market data,
# so these keys are optional enhancements.

# ---- AI / LLM ----
# Any OpenAI-compatible Chat Completions endpoint.
# If left empty, Prorun uses its local rule-based analysis engine.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# ---- Market data ----
# CoinGecko public API is used with a free rate limit. No key required.
# Set a longer cache TTL (seconds) if you hit rate limits.
MARKET_CACHE_TTL=60

# ---- Database (optional PostgreSQL) ----
# If set, Prorun persists demo data to Postgres via pg.
# If empty, it falls back to a local file-backed / in-memory store.
DATABASE_URL=

# ---- Web (optional, for reference only) ----
# Blockchain portfolio indexing currently uses a deterministic simulation
# so the demo works without paid API keys.