# OpenRouter API Key
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Model to use (default is a free-tier model)
# Free models: deepseek/deepseek-chat-v3-0324:free, google/gemma-2-9b-it:free, mistralai/mistral-7b-instruct:free
# Paid models: anthropic/claude-3.5-sonnet, openai/gpt-4o, etc.
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# Optional: Your site URL for OpenRouter attribution
OPENROUTER_SITE_URL=https://okx-ai-ten.vercel.app
OPENROUTER_SITE_NAME=Prorun AI